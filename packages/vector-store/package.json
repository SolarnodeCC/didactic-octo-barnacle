{
  "name": "@roi/vector-store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./recall-corpus": {
      "types": "./dist/recall-corpus.d.ts",
      "import": "./dist/recall-corpus.js"
