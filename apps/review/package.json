{
  "name": "@roi/review",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "dev": "vite build && wrangler d1 migrations apply DB --local --persist-to ../../infrastructure/cloudflare/.wrangler/state && wrangler dev --persist-to ../../infrastructure/cloudflare/.wrangler/state",
    "seed:local": "wrangler d1 execute DB --local --persist-to ../../infrastructure/cloudflare/.wrangler/state --file seed/local.sql"
  },
  "dependencies": {
    "@roi/models": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "better-sqlite3": "^13.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.163.0"
  }
}
