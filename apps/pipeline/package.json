    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^11.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "bin": {
    "roi-scope-lookup": "./dist/scope/lookup-cli.js"
  }
}
