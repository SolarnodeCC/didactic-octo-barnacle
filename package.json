{
  "name": "research-opportunity-intelligence",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @roi/models --filter @roi/prompts run build && pnpm -r run typecheck && tsc -p test-support",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm --filter @roi/models --filter @roi/prompts run build && pnpm -r run test:unit",
    "test:integration": "pnpm --filter @roi/models --filter @roi/prompts run build && pnpm -r run test:integration",
    "test:coverage": "pnpm --filter @roi/models --filter @roi/prompts run build && pnpm -r run test:coverage",
    "check:traceability": "python3 scripts/check-traceability.py",
    "check:scripts": "python3 -m unittest discover -s scripts/tests",
    "check:hardening": "python3 scripts/check-hardening.py",
    "audit:ci": "pnpm audit --prod && pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3",
      "workerd"
    ],
    "overrides": {
      "minimatch": "^11.0.1"
    }
  }
}
